Section "Device"                                                                                                                                                                                                
    Identifier "Device0"                                                                                                                                                                                        
    Driver     "modesetting"  
    Option "kmsdev" "/dev/dri/card1"                                                                                                                                                                           
    #Option  "SWCursor" "true" #Using sw cursor                                                                                                                                                                                                                                                                                                                                                  
    Option "AccelMethod" "glamor"
EndSection
